# Copy to .env and adjust for your environment.
# Loaded via `docker run --env-file .env` (see README / Makefile).

# Postgres connection string (for running the app outside Docker)
# (5433 avoids colliding with any local Postgres/Supabase on 5432)
DATABASE_URL=postgres://pageturner:pageturner@localhost:5433/pageturner?sslmode=disable

# Port the web server listens on
PORT=8909

# IMPORTANT: set a long random string in production
SESSION_SECRET=change-me-in-production

# Session lifetime, e.g. 168h (default) or 720h
SESSION_TTL=168h

# "text" (default) or "json"
LOG_FORMAT=text

# Set to "true" when serving over HTTPS so cookies get the Secure flag
COOKIE_SECURE=false

# Demo login, seeded into SQLite on boot (created once, skipped afterwards)
SEED_EMAIL=demo@markitdown.app
SEED_PASSWORD=change-me-too
